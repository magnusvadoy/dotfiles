[user]
  name = Magnus Furnes Vadøy
  email = magnus.f.vadoy@gmail.com

# Work identity and commit signing for everything under ~/code
[includeIf "gitdir:~/code/work/"]
  path = ~/.gitconfig_work

[core]
  excludesfile = ~/.gitignore_global
  ignorecase = false # avoid problems when changing a case of a filename
  editor = nvim
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  # use n and N to move between diff sections
  navigate = true
  syntax-theme = gruvbox-material-dark

[merge]
  conflictstyle = zdiff3
  tool = nvimdiff

[status]
  # Show untracked files, directories and files in untracked directories
  showUntrackedFiles = all

[push]
  # Push the current branch to the same branch on the remote
  autoSetupRemote = true
  followTags = true # push annotated tags along with commits

[pull]
  # Keep local commits on top of the tree
  rebase = true

[rebase]
  # Stash and pop uncommitted changes on rebase
  autoStash = true
  updateRefs = true # move stacked branches along when rebasing

[fetch]
  prune = true # Remove remote tracking branches that no longer exist on the remote
  pruneTags = true # Remove tags that no longer exist on the remote

[alias]
  amend = commit -v --amend
  amend-no-edit = commit --amend --no-edit
  squash = merge --squash
  reset-last-commit = reset HEAD~1
  hard-reset-last-commit = reset --hard HEAD~1

[mergetool]
  prompt = false

[init]
  defaultBranch = main

[diff]
  algorithm = histogram # better diffs when code is moved around

[rerere]
  enabled = true # remember how conflicts were resolved and reuse it

[branch]
  sort = -committerdate # most recently used branches first

[tag]
  sort = version:refname
