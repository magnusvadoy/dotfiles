tap "shuntaka9576/tap"
tap "steipete/tap"

# Shell & core
brew "fish"
brew "bash"
brew "zsh"
brew "git"
brew "gh"
brew "yadm"
brew "openssh"
brew "rsync"
brew "wget"
brew "curl"
brew "coreutils"
brew "gnu-sed"
brew "watch"
brew "htop"
brew "terminal-notifier"

# Editor & terminal tools
brew "neovim"
brew "tree-sitter-cli"
brew "neovide"
brew "tmux"
brew "gitmux"
brew "sesh"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "zoxide"
brew "yazi"
brew "git-delta"
brew "lazygit"
brew "starship"
brew "mpv"
brew "imagemagick"
brew "pngpaste"

# Languages & build (runtimes are managed by mise)
brew "mise"
brew "semtag"

# Data & APIs
brew "jq"
brew "yq"
brew "httpie"
brew "grpcurl"
brew "grpcui"
brew "protobuf"
brew "kcat"
brew "libpq"

# Cloud & Kubernetes
brew "kubernetes-cli"
brew "kubectx"
brew "sops"

# Terminal & dev apps
cask "ghostty"
cask "docker-desktop"
cask "intellij-idea"
cask "bruno"
cask "codex"
cask "codexbar"
cask "agentoast"
cask "1password"
cask "1password-cli"

# macOS utilities
cask "karabiner-elements"
cask "rectangle"
cask "scroll-reverser"
cask "hiddenbar"
cask "clipy"
cask "caffeine"
cask "appcleaner"

# Apps
cask "brave-browser"
cask "obsidian"
cask "spotify"
cask "discord"
cask "telegram"

# Fonts
cask "font-jetbrains-mono"
