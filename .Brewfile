tap "anomalyco/tap"
tap "shuntaka9576/tap"

# Shell & core
brew "bash"
brew "zsh"
brew "git"
brew "gh"
brew "yadm"
brew "openssh"
brew "rsync"
brew "wget"
brew "curl"
brew "coreutils"
brew "gnu-sed"
brew "watch"
brew "terminal-notifier"

# Editor & terminal tools
brew "neovim"
brew "tree-sitter-cli"
brew "tmux"
brew "gitmux"
brew "sesh"
brew "fzf"
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"
brew "zoxide"
brew "direnv"
brew "yazi"
brew "git-delta"
brew "lazygit"
brew "mpv"
brew "imagemagick"
brew "pngpaste"
brew "forgit"

# Languages & build (runtimes are managed by mise)
brew "mise"

# AI agents
brew "anomalyco/tap/opencode"

# Data & APIs
brew "jq"
brew "yq"
brew "grpcurl"
brew "grpcui"
brew "protobuf"
brew "kcat"

# Password managers (1Password is the SSH agent and commit signer)
cask "1password"
cask "1password-cli"
cask "bitwarden"
brew "bitwarden-cli"

# Cloud & Kubernetes
brew "kubernetes-cli"
brew "kubectx"
brew "k9s"

# Terminal & dev apps
cask "ghostty"
cask "docker-desktop"
cask "bruno"
cask "codex"
cask "agentoast"

# macOS utilities
cask "hammerspoon"
cask "karabiner-elements"
cask "rectangle"
cask "scroll-reverser"

# Apps
cask "brave-browser"
cask "obsidian"
cask "spotify"
cask "discord"
cask "telegram"

# Fonts
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"
cask "font-symbols-only-nerd-font"
