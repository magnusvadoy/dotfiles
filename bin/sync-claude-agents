#!/bin/bash

# Generate Claude Code subagents from the opencode agents, so both tools share
# the same prompts. opencode is the source of truth: edit
# ~/.config/opencode/agents/*.md and re-run this script.

set -euo pipefail

src="$HOME/.config/opencode/agents"
dst="$HOME/.claude/agents"

# Claude Code tool allowlist per agent. Agents not listed here are skipped
# (e.g. primary agents like caveman, which maps to a Claude output style).
tools_for() {
  case "$1" in
  architect) echo "Read, Grep, Glob, WebFetch, WebSearch" ;;
  debugger) echo "Read, Grep, Glob, Bash" ;;
  docs) echo "Read, Grep, Glob, Edit, Write" ;;
  reviewer) echo "Read, Grep, Glob, Bash, WebFetch, WebSearch" ;;
  esac
}

mkdir -p "$dst"

for file in "$src"/*.md; do
  name=$(basename "$file" .md)
  tools=$(tools_for "$name")
  [[ -z "$tools" ]] && continue

  description=$(awk '/^---$/ { n++; next } n == 1 && /^description:/ { sub(/^description: */, ""); print; exit }' "$file")
  body=$(awk '/^---$/ && n < 2 { n++; next } n >= 2' "$file")

  {
    echo "---"
    echo "name: $name"
    echo "description: $description"
    echo "tools: $tools"
    echo "---"
    echo "<!-- Generated by ~/bin/sync-claude-agents from ~/.config/opencode/agents/$name.md. Do not edit. -->"
    echo "$body"
  } >"$dst/$name.md"

  echo "Synced $name"
done
