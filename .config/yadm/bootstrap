#!/bin/sh
set -e

install_brew_and_packages() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi

  if [ -f "$HOME/.Brewfile" ]; then
    echo "Updating Homebrew bundle"
    brew bundle --global
  fi
}

clone_if_missing() {
  [ -d "$2" ] || git clone "$1" "$2"
}

configure() {
  # Submodules (ghostty shaders)
  yadm submodule update --init --recursive

  # Language runtimes
  mise install

  # tmux plugin manager (plugins are installed with prefix + I)
  clone_if_missing https://github.com/tmux-plugins/tpm "$HOME/.config/tmux/plugins/tpm"

  # Setup BAT
  bat cache --build

  # Make Homebrew's JDK visible to /usr/libexec/java_home
  sudo ln -sfn /opt/homebrew/opt/openjdk/libexec/openjdk.jdk /Library/Java/JavaVirtualMachines/openjdk.jdk

  # Fish plugins and Tide prompt
  fish -c 'type -q fisher; or begin; curl -sL https://raw.githubusercontent.com/jorgebucaran/fisher/main/functions/fisher.fish | source; end; fisher update'
  fish -c "tide configure --auto --style=Lean --prompt_colors='16 colors' --show_time=No --lean_prompt_height='Two lines' --prompt_connection=Disconnected --prompt_spacing=Compact --icons='Few icons' --transient=No"

  # Use fish as login shell
  FISH="$(brew --prefix)/bin/fish"
  grep -qx "$FISH" /etc/shells || echo "$FISH" | sudo tee -a /etc/shells >/dev/null
  [ "$SHELL" = "$FISH" ] || chsh -s "$FISH"
}

install_brew_and_packages
configure
