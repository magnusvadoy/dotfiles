#!/bin/sh
set -e

install_brew_and_packages() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi

  if [ -f "$HOME/.Brewfile" ]; then
    echo "Updating Homebrew bundle"
    brew bundle --global
  fi
}

clone_if_missing() {
  [ -d "$2" ] || git clone "$1" "$2"
}

configure() {
  # Submodules (ghostty shaders)
  yadm submodule update --init --recursive

  # Language runtimes
  mise install

  # Claude Code (native installer, updates itself)
  [ -x "$HOME/.local/bin/claude" ] || curl -fsSL https://claude.ai/install.sh | bash

  # tmux plugin manager (plugins are installed with prefix + I)
  clone_if_missing https://github.com/tmux-plugins/tpm "$HOME/.config/tmux/plugins/tpm"

  # Setup BAT
  bat cache --build

  # Hammerspoon reads its config from ~/.config/hammerspoon (Claude agent notifications)
  defaults write org.hammerspoon.Hammerspoon MJConfigFile "~/.config/hammerspoon/init.lua"

  # Use Homebrew's zsh as login shell
  ZSH="$(brew --prefix)/bin/zsh"
  grep -qx "$ZSH" /etc/shells || echo "$ZSH" | sudo tee -a /etc/shells >/dev/null
  [ "$SHELL" = "$ZSH" ] || chsh -s "$ZSH"
}

install_brew_and_packages
configure
