{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5.6-terra",
  "small_model": "github-copilot/claude-haiku-4.5",
  "default_agent": "build",
  "permission": {
    "external_directory": {
      "~/code/**": "allow",
      "~/go/pkg/mod/**": "allow",
      "~/.m2/repository/**": "allow",
    },
    "edit": {
      "~/go/pkg/mod/**": "deny",
      "~/.m2/repository/**": "deny",
    },
  },
}
