\set QUIET 1

-- Switch to vertical output automatically when rows are too wide
\x auto

-- Show how long each query takes
\timing on

-- Make NULLs visible instead of blank
\pset null '∅'

-- Use nicer table borders
\pset linestyle unicode
\pset border 2

-- If a statement fails inside a transaction, roll back just that statement
-- instead of the whole transaction (interactive sessions only)
\set ON_ERROR_ROLLBACK interactive

-- Keep a separate history file for each database, and skip duplicates
\set HISTFILE ~/.psql_history- :DBNAME
\set HISTCONTROL ignoredups
\set COMP_KEYWORD_CASE upper

-- Show user@host:db in the prompt, plus a * when inside a transaction
\set PROMPT1 '%n@%m:%/%R%x%# '

\set QUIET 0
