{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Edit(~/go/pkg/mod/**)",
      "Edit(~/.m2/repository/**)"
    ],
    "additionalDirectories": [
      "~/code",
      "~/go/pkg/mod",
      "~/.m2/repository"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "agentoast hook claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "agentoast hook claude"
          }
        ]
      }
    ]
  },
  "outputStyle": "caveman",
  "modelSettings": {},
  "enabledPlugins": {}
}
